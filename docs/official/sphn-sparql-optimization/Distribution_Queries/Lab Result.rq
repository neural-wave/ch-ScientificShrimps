DEFINE sql:select-option "order"

PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ucum: <https://biomedit.ch/rdf/sphn-resource/ucum/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX einstein: <https://biomedit.ch/rdf/sphn-resource/einstein/shortcuts#>
SELECT ?Quantitative_Lab_Result_unit_filter ?Quantitative_Lab_Result_filter
WHERE {
    {
        SELECT ?pseudo_id
        WHERE {
            {
                SELECT ?pseudo_id (MAX(?diagnosis_filter) AS ?diagnosis_alias) (MAX(?lab_test_filter) as ?lab_test_alias) (MAX(?age_filter) as ?age_alias)
                WHERE {
                    {
                        SELECT (?g as ?pseudo_id) ?diagnosis_filter
                        WHERE {
                            {
                                SELECT DISTINCT ?g 
                                WHERE {
                                    GRAPH ?g {
                                        ?diagnosis0_code rdf:type <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/E10-E14> OPTION(inference "https://biomedit.ch/rdf/sphn-resource/global").
                                        ?diagnosis sphn:hasCode ?diagnosis0_code .
                                        ?diagnosis rdf:type sphn:BilledDiagnosis .
                                    }
                                }
                            }
                            BIND("true"^^xsd:boolean AS ?diagnosis_filter)
                        }
                    }
                    UNION
                    {
                        SELECT (?g as ?pseudo_id) ?lab_test_filter
                        WHERE {
                            {
                                SELECT DISTINCT ?g 
                                WHERE {
                                    GRAPH ?g {
                                        ?lab_test_code rdf:type <https://loinc.org/rdf/718-7> .
                                        ?lab_test sphn:hasCode ?lab_test_code.
                                        ?lab_test_event sphn:hasLabTest ?lab_test . 
                                    }
                                }
                            }
                            BIND("true"^^xsd:boolean AS ?lab_test_filter)
                        }
                    }
                    UNION
                    {
                        SELECT (?g as ?pseudo_id) ?age_filter
                        WHERE {
                            {
                                SELECT DISTINCT ?g 
                                WHERE {
                                    GRAPH ?g {
                                        ?ageDistribution_concept einstein:hasCalculatedBirthDate ?ageDistribution_temp_concept.
                                        BIND(bif:datediff("year", ?ageDistribution_temp_concept, NOW()) AS ?ageDistribution_temp)
                                        FILTER (?ageDistribution_temp > 10)
                                    }
                                }
                            }
                            BIND("true"^^xsd:boolean AS ?age_filter)
                        }
                    }
                }
                GROUP BY ?pseudo_id
            }
        FILTER (?diagnosis_alias && ?lab_test_alias && ?age_alias)
        }
    }
    GRAPH ?pseudo_id {
        ?lab_test_code rdf:type <https://loinc.org/rdf/718-7> .
        ?lab_test sphn:hasCode ?lab_test_code.
        ?lab_test_event sphn:hasLabTest ?lab_test .
        ?lab_test sphn:hasResult ?lab_test_result .
        ?lab_test_result einstein:LabResult_codereplacement1 ?lab_result_code .
        ?lab_result_code rdf:type ?Quantitative_Lab_Result_unit_filter .
        ?lab_test_result einstein:LabResult_valuereplacement1 ?Quantitative_Lab_Result_filter.
    }
}