DEFINE sql:select-option "order"

PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ucum: <https://biomedit.ch/rdf/sphn-resource/ucum/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX einstein: <https://biomedit.ch/rdf/sphn-resource/einstein/shortcuts#>
SELECT (COUNT(DISTINCT ?pseudo_id) AS ?countResult)
WHERE {
    {
        SELECT ?pseudo_id (MAX(?diagnosis_filter) AS ?diagnosis_alias) (MAX(?identity_filter) as ?identity_alias)
        WHERE {
            {
                SELECT (?g as ?pseudo_id) ?diagnosis_filter
                WHERE {
                    {
                        SELECT DISTINCT ?g 
                        WHERE {
                            GRAPH ?g {
                                ?diagnosis0_code rdf:type <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/E11> OPTION(inference "https://biomedit.ch/rdf/sphn-resource/global").
                                ?diagnosis sphn:hasCode ?diagnosis0_code .
                                ?diagnosis rdf:type sphn:BilledDiagnosis .
                            }
                        }
                    }
                    BIND("true"^^xsd:boolean AS ?diagnosis_filter)
                }
            }
            UNION
            {
                SELECT (?g as ?pseudo_id) ?identity_filter
                WHERE {
                    {
                        SELECT DISTINCT ?g 
                        WHERE {
                            GRAPH ?g {
                                ?pseudo_id rdf:type sphn:SubjectPseudoIdentifier.
                            }
                        }
                    }
                    BIND("true"^^xsd:boolean AS ?identity_filter)
                }
            }
        }
        GROUP BY ?pseudo_id
    }
    BIND(IF(?diagnosis_alias, "false"^^xsd:boolean, "true"^^xsd:boolean) AS ?diagnosis_filter_absence)
    FILTER (?identity_alias && ?diagnosis_filter_absence)
}